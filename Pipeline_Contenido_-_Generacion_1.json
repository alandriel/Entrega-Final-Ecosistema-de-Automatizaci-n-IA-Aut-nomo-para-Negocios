    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst raw = item.output?.[0]?.content?.[0]?.text || item.message || item.content || item.text || item.data || JSON.stringify(item);\nlet cleaned = String(raw).trim();\ncleaned = cleaned.replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();\nlet parsed;\ntry {\n    parsed = JSON.parse(cleaned);\n} catch (e) {\n    parsed = { categoria: 'Objetos Decorativos', completa: false };\n}\nconst categoriasValidas = ['Alfombras', 'Cuadros y Arte', 'Textiles', 'Objetos Decorativos'];\nconst categoria = categoriasValidas.includes(parsed.categoria) ? parsed.categoria : 'Objetos Decorativos';\nreturn [{ json: { categoria, completa: parsed.completa === true } }];"
      },
