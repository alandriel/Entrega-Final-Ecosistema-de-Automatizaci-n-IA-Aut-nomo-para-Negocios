      "parameters": {
        "jsCode": "const items = $input.all();\nconst bloques = items.map((item) => {\n  const data = item.json;\n  const tema = data.property_tema || data.Tema || data.tema || 'Sin tema';\n  const contenido = data.property_contenido || data.Contenido || data.contenido || '';\n  return '### ' + tema + '\\n' + contenido;\n});\nconst contexto_rag = bloques.join('\\n\\n');\nreturn [{ json: { contexto_rag } }];"
      },
      "type": "n8n-nodes-base.code",
